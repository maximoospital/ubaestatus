---
// Importamos el layout, y los componentes para construir la pagina.
import BaseLayout from "../layouts/base.layout.astro";
import Section from "../components/templates/section.component.astro";
import HeaderComponent from "../components/widgets/header.component.astro";
import HeroComponent from "../components/sections/hero.component.astro";
import AccordionComponent from "../components/sections/accordion.component.astro";
import CalendarComponent from "../components/sections/calendar.component.astro";
import ActionComponent from "../components/sections/action.component.astro";
import ContactComponent from "../components/sections/contact.component.astro";

// Importamos getEntry y cargamos el contenido del archivo markdown para la pagina de inicio.
import { getEntry } from "astro:content";

const landing = await getEntry("content", "landing");
if (!landing) throw new Error("No se pudo cargar el contenido de la pagina.");

const data = landing.data;
---

<BaseLayout {...data.meta}>
    <header>
        <HeaderComponent {...data.header} />
    </header>
    <main>
        <Section id="hero" fullWidth key="hero">
            <HeroComponent {...data.hero} />
        </Section>
        <Section id="accordion" class="bg-offwhite" key="accordion">
            <AccordionComponent {...data.accordion} />
        </Section>
        <Section id="calendar" class="bg-offwhite" key="calendar">
            <CalendarComponent {...data.calendar} />
        </Section>
        <Section id="action" class="bg-coral" key="action">
            <ActionComponent {...data.action} />
        </Section>
        <Section id="contact" class="bg-dark" key="contact">
            <ContactComponent {...data.contact} />
        </Section>
    </main>
</BaseLayout>
