---
export interface Props {
  id?: string;
  class?: string;
  fullWidth?: boolean;
  noPadding?: boolean;
  [key: string]: any;
}

const {
  id,
  class: className,
  fullWidth = false,
  noPadding = false,
  ...rest
} = Astro.props;
---

<section
  id={id}
  class:list={["w-full", !noPadding && "py-16 md:py-24", className]}
  {...rest}
>
  <div
    class:list={[
      "mx-auto h-full w-full",
      fullWidth ? "" : "max-w-7xl px-4 sm:px-6 lg:px-8",
    ]}
  >
    <slot />
  </div>
</section>
