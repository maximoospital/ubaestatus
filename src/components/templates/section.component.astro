---
export interface Props {
  id?: string;
  class?: string;
  fullWidth?: boolean;
  noPadding?: boolean;
  [key: string]: any;
}

const {
  id,
  class: className,
  fullWidth = false,
  noPadding = false,
  ...rest
} = Astro.props;
---

<section
  id={id}
  class:list={["w-full", !noPadding && "py-8 md:py-4", className]}
  {...rest}
>
  <div class:list={["mx-auto h-full w-full"]}>
    <slot />
  </div>
</section>
