---
export interface Props {
  subtitle?: string;
  timer?: "active" | "paused";
  date?: string;
}

const { subtitle = "Subtitulo.", timer = "active", date } = Astro.props;

import FlipClock from "../widgets/flip-clock.component.astro";
---

<div
  class="relative flex h-full min-h-svh w-full items-center bg-[url('/assets/bg.jpeg')] bg-cover bg-fixed bg-center bg-no-repeat"
>
  <div class="bg-dark absolute inset-0 opacity-80"></div>
  <div class="relative z-10 w-full max-w-7xl px-6 py-16 md:px-12 md:py-20">
    <h1
      class="text-display text-offwhite text-5xl sm:text-6xl md:text-7xl lg:text-8xl"
    >
      EXACTAS
    </h1>
    <h1
      class="text-display text-offwhite text-5xl sm:text-6xl md:text-7xl lg:text-8xl"
    >
      EN
    </h1>
    <h1
      class="text-display text-teal text-5xl sm:text-6xl md:text-7xl lg:text-8xl"
    >
      LUCHA.
    </h1>
    <p
      class="text-offwhite font-body mt-3 text-base text-shadow-black/50 text-shadow-lg sm:text-lg md:text-xl"
    >
      {subtitle}
    </p>
    <div class="mt-6 overflow-hidden">
      <p
        class="text-offwhite font-body bold mb-2 text-sm tracking-[0.2em] uppercase text-shadow-black/50 text-shadow-md"
      >
        El paro ya lleva:
      </p>
      <FlipClock timer={timer} date={date} />
    </div>
    <div class="mt-10">
      <a
        id="hero-cta"
        href="#bento"
        class="bg-teal text-dark font-body hover:bg-offwhite inline-block rounded-sm px-7 py-3.5 text-base font-bold tracking-[0.2em] uppercase transition-colors sm:px-9 sm:py-4 sm:text-lg"
      >
        Conoce la situación
      </a>
    </div>
  </div>
  <!-- scroll down indicator de https://codepen.io/mikewagz/pen/PGXqOg -->
  <div
    class="scroll-down-dude absolute bottom-8 left-1/2 -translate-x-1/2 opacity-80"
  >
  </div>
</div>
