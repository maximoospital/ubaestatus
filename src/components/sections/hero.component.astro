---
export interface Props {
  subtitle?: string;
}

const { subtitle = "Subtitulo." } = Astro.props;
---

<div
  class="relative flex h-full min-h-[calc(90vh)] w-full items-center bg-[url('/assets/bg.jpeg')] bg-cover bg-fixed bg-center bg-no-repeat md:min-h-[calc(90vh)]"
>
  <div class="bg-dark absolute inset-0 opacity-80"></div>
  <div class="relative z-10 mb-4 ml-6 md:mb-8">
    <h1 class="text-display text-offwhite text-9xl">EXACTAS</h1>
    <h1 class="text-display text-offwhite text-9xl">EN</h1>
    <h1 class="text-display text-teal text-9xl">LUCHA</h1>
    <p class="text-h4 text-offwhite font-body mt-2 ml-2 opacity-80 md:mt-2">
      {subtitle}
    </p>
  </div>
  <!-- scroll down indicator de https://codepen.io/mikewagz/pen/PGXqOg -->
  <div
    class="scroll-down-dude absolute bottom-8 left-1/2 -translate-x-1/2 opacity-80"
  >
  </div>
</div>
