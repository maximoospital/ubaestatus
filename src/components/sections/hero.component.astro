---
export interface Props {
  subtitle?: string;
}

const { subtitle = "Subtitulo." } = Astro.props;
---

<div
  class="relative flex h-full min-h-[calc(100vh)] w-full items-end bg-[url('/assets/bg.jpeg')] bg-cover bg-fixed bg-center bg-no-repeat md:min-h-[calc(100vh)]"
>
  <div class="bg-dark absolute inset-0 opacity-80"></div>
  <div class="relative z-10 mb-4 ml-6 max-w-5xl md:mb-8">
    <h1 class="text-display text-offwhite">EXACTAS</h1>
    <h1 class="text-display text-offwhite">EN</h1>
    <h1 class="text-display text-teal">LUCHA</h1>
    <p
      class="text-h4 text-offwhite font-body mt-4 ml-1 max-w-2xl opacity-80 md:mt-8"
    >
      {subtitle}
    </p>
  </div>
</div>
