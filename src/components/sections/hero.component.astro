---
export interface Props {
  subtitle?: string;
}

const { subtitle = "Subtitulo." } = Astro.props;
---

<div
  class="relative flex h-full min-h-[calc(90vh)] w-full items-center bg-[url('/assets/bg.jpeg')] bg-cover bg-fixed bg-center bg-no-repeat md:min-h-[calc(90vh)]"
>
  <div class="bg-dark absolute inset-0 opacity-80"></div>
  <div class="relative z-10 mb-4 ml-6 md:mb-8">
    <h1 class="text-display text-offwhite text-8xl">EXACTAS</h1>
    <h1 class="text-display text-offwhite text-8xl">EN</h1>
    <h1 class="text-display text-teal text-8xl">LUCHA.</h1>
    <p
      class="text-h3 text-offwhite font-body mt-2 ml-2 text-shadow-black/50 text-shadow-lg md:mt-2"
    >
      {subtitle}
    </p>
    <div class="mt-6 ml-2">
      <a
        id="hero-cta"
        href="#bento"
        class="bg-teal text-dark font-body hover:bg-offwhite text-md inline-block rounded-sm px-6 py-3 font-bold tracking-[0.2em] uppercase transition-colors"
      >
        Conoce la situación
      </a>
    </div>
  </div>
  <!-- scroll down indicator de https://codepen.io/mikewagz/pen/PGXqOg -->
  <div
    class="scroll-down-dude absolute bottom-8 left-1/2 -translate-x-1/2 opacity-80"
  >
  </div>
</div>
