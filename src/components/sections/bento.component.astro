---
// ─── Props ────────────────────────────────────────────────────────────────────
import type { BentoCard } from "../../shared/bento.types";

export interface Props {
  cards: BentoCard[];
}

const { cards } = Astro.props;

// Build the ITEMS map for Alpine from card data
const items = Object.fromEntries(
  cards.map((c) => [
    c.id,
    {
      category: c.modal.category,
      title: c.modal.title,
      body: c.modal.body,
      media: c.modal.media ?? null,
      source: c.modal.source ?? "",
      cta: c.modal.cta ?? null,
    },
  ]),
);

function accentClass(color: "teal" | "coral" | "none"): string {
  if (color === "teal") return "card--teal";
  if (color === "coral") return "card--coral";
  return "";
}

function readMoreMod(color: "teal" | "coral" | "none"): string {
  if (color === "coral") return "card-read-more--coral";
  return "";
}
---

<div x-data="bentoModal()" @keydown.escape.window="closeModal()">
  <div class="bento-grid">
    {
      cards.map((card) => {
        const accent = accentClass(card.color);
        const rm = readMoreMod(card.color);
        const baseAttrs = {
          class: `card card-${card.id} ${accent}`.trim(),
          "@click": `openModal('${card.id}')`,
          role: "button",
          tabindex: "0",
          "@keydown.enter": `openModal('${card.id}')`,
          "@keydown.space.prevent": `openModal('${card.id}')`,
        };

        if (card.type === "hero-stat") {
          return (
            <div {...baseAttrs}>
              {card.eyebrow && <div class="eyebrow">{card.eyebrow}</div>}
              <div class="num">{card.num}</div>
              <div class="label">{card.label}</div>
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "date-event") {
          return (
            <div {...baseAttrs}>
              <div>
                {card.eyebrow && <div class="eyebrow">{card.eyebrow}</div>}
                <div class="date-big">{card.date}</div>
                <div class="date-label">{card.dateLabel}</div>
                {card.dateSub && <div class="date-sub">{card.dateSub}</div>}
              </div>
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "stat-pills") {
          return (
            <div {...baseAttrs}>
              <div>
                {card.eyebrow && <div class="eyebrow">{card.eyebrow}</div>}
                <div class="num">{card.num}</div>
                <div class="label">{card.label}</div>
                <div class="pills-wrap">
                  {card.pills.map((p) => (
                    <span
                      class={`pill ${p.color === "teal" ? "pill-teal" : p.color === "coral" ? "pill-coral" : ""}`.trim()}
                    >
                      {p.text}
                    </span>
                  ))}
                </div>
              </div>

              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "category-pills") {
          return (
            <div {...baseAttrs}>
              <div class="category-name">{card.categoryName}</div>
              {card.categoryFocus && (
                <div class="category-focus">{card.categoryFocus}</div>
              )}
              <div class="pills-wrap">
                {card.pills.map((p) => (
                  <span
                    class={`pill ${p.color === "teal" ? "pill-teal" : p.color === "coral" ? "pill-coral" : ""}`.trim()}
                  >
                    {p.text}
                  </span>
                ))}
              </div>
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "icon-list") {
          return (
            <div {...baseAttrs}>
              <div class="action-heading">{card.heading}</div>
              <div class="icon-row">
                {card.items.map((item) => (
                  <div class="icon-item">
                    <span>{item.icon}</span> {item.text}
                  </div>
                ))}
              </div>
              {card.subtext && <div class="action-sub">{card.subtext}</div>}
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "text-block") {
          return (
            <div {...baseAttrs}>
              {card.tag && (
                <div
                  class={card.color === "coral" ? "money-tag" : "detail-tag"}
                >
                  {card.tag}
                </div>
              )}
              <div
                class="text-big"
                set:html={card.textBig.replace(/\n/g, "<br />")}
              />
              {card.textSub && <div class="text-sub">{card.textSub}</div>}
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "stat-tagged") {
          return (
            <div {...baseAttrs}>
              <div>
                <div class={card.color === "coral" ? "red-tag" : "detail-tag"}>
                  {card.tag}
                </div>
                <div class="num">{card.num}</div>
                <div class="label">{card.label}</div>
              </div>
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "quote-block") {
          return (
            <div {...baseAttrs}>
              <div class="quote-big">
                {card.quoteLines.map((line, i) => (
                  <>
                    <em>{line}</em>
                    {i < card.quoteLines.length - 1 && <br />}
                  </>
                ))}
              </div>
              {card.quoteSub && <div class="quote-sub">{card.quoteSub}</div>}
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "eyebrow-stat") {
          return (
            <div {...baseAttrs}>
              {card.eyebrow && <div class="eyebrow">{card.eyebrow}</div>}
              <div class="num">{card.num}</div>
              <div class="label">{card.label}</div>
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        if (card.type === "bar-chart") {
          return (
            <div {...baseAttrs}>
              <div class="chart-header">
                <div
                  class="chart-title"
                  set:html={card.chartTitle.replace(/\n/g, "<br />")}
                />
                {card.chartBadge && (
                  <div class="chart-badge-val">{card.chartBadge}</div>
                )}
              </div>
              <div class="chart-bars">
                {card.bars.map((bar) => (
                  <div class="bar-group">
                    <div class="bar-val">{bar.value}</div>
                    <div
                      class="bar"
                      style={`height:${bar.heightPx}px; background:linear-gradient(180deg,${bar.gradientFrom},${bar.gradientTo});${bar.opacity !== undefined && bar.opacity !== 1 ? ` opacity:${bar.opacity}` : ""}`}
                    />
                    <div class="bar-lbl">{bar.year}</div>
                  </div>
                ))}
              </div>
              <span class={`card-read-more ${rm}`.trim()}>Leer más →</span>
            </div>
          );
        }

        return null;
      })
    }
  </div>

  <!-- MODAL OVERLAY -->
  <div
    x-show="open"
    @click.self="closeModal()"
    x-transition:enter="transition-opacity duration-200 ease-out"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity duration-150 ease-in"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="modal-overlay"
    style="display:none"
    role="dialog"
    aria-modal="true"
  >
    <div
      class="modal"
      @click.stop
      data-lenis-prevent
      x-show="open"
      x-transition:enter="transition-[opacity,transform] duration-250 ease-[cubic-bezier(0.16,1,0.3,1)]"
      x-transition:enter-start="opacity-0 scale-95 translate-y-2"
      x-transition:enter-end="opacity-100 scale-100 translate-y-0"
      x-transition:leave="transition-[opacity,transform] duration-150 ease-in"
      x-transition:leave-start="opacity-100 scale-100 translate-y-0"
      x-transition:leave-end="opacity-0 scale-95 translate-y-2"
    >
      <button class="modal-close" @click="closeModal()" aria-label="Cerrar">
        <svg
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          aria-hidden="true"
        >
          <line
            x1="1"
            y1="1"
            x2="11"
            y2="11"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="11"
            y1="1"
            x2="1"
            y2="11"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></line>
        </svg>
      </button>
      <div class="modal-category" x-text="item.category"></div>
      <div class="modal-title" x-text="item.title"></div>
      <img
        class="modal-media"
        :src="item.media || ''"
        :alt="item.title"
        x-show="item.media"
        style="display:none"
      />
      <div class="modal-body" x-text="item.body"></div>
      <div class="modal-footer">
        <div
          class="modal-source"
          x-html="'<strong>Fuente:</strong> ' + (item.source || '')"
        >
        </div>
        <a
          class="modal-cta"
          :href="item.cta?.url || '#'"
          target="_blank"
          rel="noopener"
          x-text="(item.cta?.label || '') + ' →'"
          x-show="item.cta"
          style="display:none"></a>
      </div>
    </div>
  </div>
</div>

<style></style>

<script define:vars={{ items }}>
  const ITEMS = items;

  // Register Alpine component
  document.addEventListener("alpine:init", () => {
    // @ts-ignore
    Alpine.data("bentoModal", () => ({
      open: false,
      item: {},
      openModal(id) {
        this.item = ITEMS[id] || {};
        this.open = true;
        document.body.style.overflow = "hidden";
        window.lenis?.stop();
      },
      closeModal() {
        this.open = false;
        document.body.style.overflow = "";
        window.lenis?.start();
      },
    }));
  });
</script>
