---
import { Icon } from "astro-icon/components";

interface responsableProfile {
    name: string;
    description: string;
    party: string;
    role: string;
    email: string;
    emailLabel?: string;
}

const {
    title = "TITULO",
    subtitle = "SUBTITULO",
    description = "Descripcion.",
    responsableProfile = [],
} = Astro.props as {
    title?: string;
    subtitle?: string;
    description?: string;
    responsableProfile?: responsableProfile[];
};
---

<div
    class="relative flex w-full flex-col items-start px-6 py-8 lg:px-8"
>
    <div class="mb-12 text-left">
        <h2 class="text-display text-offwhite text-2xl sm:text-3xl md:text-4xl">
            {title}
        </h2>
        <h2
            class="text-display mt-1 text-4xl text-black sm:text-5xl md:text-6xl lg:text-7xl"
        >
            {subtitle}
        </h2>
        <p class="text-h3 text-offwhite mt-2 text-base font-normal sm:text-lg">
            {description}
        </p>
    </div>

    <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
            responsableProfile.map((profile) => (
                <a
                    href={profile.email}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="instagram-card bg-offwhite group flex flex-col justify-between border px-8 py-6 transition-colors gap-4"
                >
                    <div class="flex flex-col items-start text-left gap-1">
                        <span class="text-display text-2xl font-bold text-black leading-tight">
                            {profile.name}
                        </span>
                        <span class="text-label text-xs tracking-widest text-black/50 uppercase">
                            {profile.role} · {profile.party}
                        </span>
                    </div>
                    <div class="flex items-center justify-between gap-2">
                        <span class="hover-target text-h3 text-navy text-sm underline underline-offset-2 transition-colors break-all">
                            {profile.emailLabel ?? profile.email.replace("mailto:", "")}
                        </span>
                        <Icon
                            name="mdi:email"
                            class="hover-target text-mid h-5 w-5 shrink-0 transition-colors"
                        />
                    </div>
                </a>
            ))
        }
    </div>
</div>
