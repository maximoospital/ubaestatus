---
import { Icon } from "astro-icon/components";

interface InstagramProfile {
  name: string;
  handle: string;
  url: string;
  color: string;
}

const {
  title = "TITULO",
  subtitle = "SUBTITULO",
  description = "Descripcion.",
  instagramProfiles = [],
} = Astro.props as {
  title?: string;
  subtitle?: string;
  description?: string;
  instagramProfiles?: InstagramProfile[];
};
---

<style>
  .instagram-card {
    border-color: var(--color-rule-dark);
  }
  .instagram-card:hover {
    border-color: var(--hover-color) !important;
  }
  .instagram-card:hover .hover-target {
    color: var(--hover-color) !important;
  }
</style>

<div class="relative flex w-full flex-col items-start px-6 py-16 lg:px-12">
  <div class="mb-12 text-left">
    <h2 class="text-display text-h2 text-offwhite">{title}</h2>
    <h2 class="text-display text-h1 text-teal">{subtitle}</h2>
    <p class="text-h3 text-offwhite mt-4 font-normal">
      {description}
    </p>
  </div>

  <div class="flex w-full flex-wrap justify-start gap-6">
    {
      instagramProfiles.map((profile) => (
        <a
          href={profile.url}
          target="_blank"
          rel="noopener noreferrer"
          class="instagram-card bg-offwhite group flex min-w-[250px] flex-auto items-center justify-between border px-8 py-6 transition-colors sm:min-w-[300px]"
          style={`--hover-color: ${profile.color}`}
        >
          <div class="flex flex-col items-start text-left">
            <span class="text-label text-mid mb-1 tracking-widest">
              {profile.name}
            </span>
            <span class="hover-target text-h3 text-navy transition-colors">
              {profile.handle}
            </span>
          </div>
          <Icon
            name="mdi:instagram"
            class="hover-target text-mid h-6 w-6 transition-colors"
          />
        </a>
      ))
    }
  </div>
</div>
