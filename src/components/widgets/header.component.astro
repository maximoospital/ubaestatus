---
import ShareComponent from "./share.component.astro";
import { Icon } from "astro-icon/components";

const data = Astro.props;
---

<header
  id="header-bar"
  class="fixed top-0 left-0 z-40 w-full border-b border-transparent bg-transparent transition-colors duration-300"
>
  <div class="progress bg-teal"></div>
  <div
    id="header-inner"
    class="container mx-auto flex flex-row items-center justify-between gap-2 px-3 py-3 transition-all duration-300 md:px-4 md:py-8"
  >
    <h1
      id="header-logo"
      class="text-h3 md:text-h2 text-offwhite hidden sm:flex flex-row items-center gap-2 leading-none opacity-0 transition-opacity duration-300"
    >
      <span
        class="bg-teal block h-[0.8em] w-1 shrink-0 translate-y-[-0.05em] rounded-full"
      ></span>
      {data.title}
    </h1>
    <nav class="flex items-center gap-2 md:gap-6">
      <ul class="flex flex-wrap items-center justify-end gap-x-2 gap-y-1 sm:gap-x-3 md:gap-4">
        <li>
          <a
            href="#hero"
            class="text-offwhite/70 hover:text-teal hover:decoration-teal focus-visible:ring-teal focus-visible:ring-offset-dark active:text-teal active:decoration-teal text-xs sm:text-sm font-medium tracking-[0.01em] decoration-transparent underline-offset-6 transition-colors duration-200 hover:underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:underline"
            >Inicio</a
          >
        </li>
        <li>
          <a
            href="#bento"
            class="text-offwhite/70 hover:text-teal hover:decoration-teal focus-visible:ring-teal focus-visible:ring-offset-dark active:text-teal active:decoration-teal text-xs sm:text-sm font-medium tracking-[0.01em] decoration-transparent underline-offset-6 transition-colors duration-200 hover:underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:underline"
            >Situación</a
          >
        </li>
        <li>
          <a
            href="#calendar"
            class="text-offwhite/70 hover:text-teal hover:decoration-teal focus-visible:ring-teal focus-visible:ring-offset-dark active:text-teal active:decoration-teal text-xs sm:text-sm font-medium tracking-[0.01em] decoration-transparent underline-offset-6 transition-colors duration-200 hover:underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:underline"
            >Agenda</a
          >
        </li>
        <li>
          <a
            href="#action"
            class="text-offwhite/70 hover:text-teal hover:decoration-teal focus-visible:ring-teal focus-visible:ring-offset-dark active:text-teal active:decoration-teal text-xs sm:text-sm font-medium tracking-[0.01em] decoration-transparent underline-offset-6 transition-colors duration-200 hover:underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:underline"
            >Acción</a
          >
        </li>
        <li>
          <a
            href="#contact"
            class="text-offwhite/70 hover:text-teal hover:decoration-teal focus-visible:ring-teal focus-visible:ring-offset-dark active:text-teal active:decoration-teal text-xs sm:text-sm font-medium tracking-[0.01em] decoration-transparent underline-offset-6 transition-colors duration-200 hover:underline focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:underline"
            >Contacto</a
          >
        </li>
      </ul>
      <button
        type="button"
        x-data
        @click="$dispatch('open-share')"
        class="bg-teal hover:bg-teal-dark active:bg-teal-dark inline-flex items-center gap-1 rounded p-2 text-sm font-semibold tracking-[0.01em] whitespace-nowrap text-white transition-colors duration-200 hover:cursor-pointer md:px-4 md:py-2"
        id="share"
        ><Icon name="mdi:share" class="text-lg md:text-sm" /><span
          class="hidden md:inline">Compartir</span
        ></button
      >
    </nav>
  </div>
</header>

<ShareComponent shareText={data.shareText} shareUrl={data.shareUrl} />
